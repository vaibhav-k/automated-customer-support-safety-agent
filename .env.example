# Copy to .env and fill in. Never commit .env. All auth is keyless (Microsoft Entra ID via DefaultAzureCredential).

# --- Azure AI Foundry project ---------------------------------------------------------
# Foundry portal > your project > Overview > "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AGENT_NAME=contoso-support-agent
AGENT_TEMPERATURE=0.2

# --- Azure AI Content Safety (Layer 1 gate) -------------------------------------------
CONTENT_SAFETY_ENDPOINT=https://<content-safety-resource>.cognitiveservices.azure.com
# Block when any harm category severity >= this value (FourSeverityLevels: 0, 2, 4, 6)
HARM_SEVERITY_THRESHOLD=4
# true = block requests if Content Safety is unreachable (recommended for production)
SAFETY_FAIL_CLOSED=true
MAX_INPUT_CHARS=4000

# --- Azure AI Search (RAG knowledge base) ---------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=contoso-policy-index
# Name of the Azure AI Search connection in the Foundry project (Management center > Connected resources)
AZURE_SEARCH_CONNECTION_NAME=<search-connection-name>
AZURE_SEARCH_TOP_K=5
# LAB FALLBACK ONLY (leave empty to stay keyless). Admin key from AI Search > Settings > Keys.
# Use when you cannot be granted Search Index Data Contributor. Never commit a real key.
AZURE_SEARCH_API_KEY=

# --- Embeddings for ingestion (Azure OpenAI endpoint of the Foundry resource) --------
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
POLICY_BASE_URL=https://policies.contoso.example/contoso_policy.md
# LAB FALLBACK ONLY: Foundry resource key (Keys and Endpoint) stored in the index vectorizer so the
# agent's vector queries work without granting the search service's managed identity a role.
AZURE_OPENAI_VECTORIZER_API_KEY=

# --- Order Status API (Azure Function) tool -------------------------------------------
ORDER_API_BASE_URL=https://<function-app-name>.azurewebsites.net/api
# Foundry "Custom keys" connection holding x-functions-key. Leave empty for anonymous auth.
ORDER_API_CONNECTION_NAME=contoso-order-api-key
